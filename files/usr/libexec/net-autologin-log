#!/bin/sh

case "$#" in
	0) level=all; limit=200 ;;
	2) level="$1"; limit="$2" ;;
	*) exit 2 ;;
esac

case "$level" in
	all|info|warn|err) ;;
	*) exit 2 ;;
esac
case "$limit" in
	25|50|100|200) ;;
	*) exit 2 ;;
esac

set -o pipefail

# logread matches basic regular expressions against the message before adding timestamps.
/sbin/logread -e '^net-autologin\(\[[0-9][0-9]*\]\)\{0,1\}: ' |
	LC_ALL=C /usr/bin/awk -v filter="$level" -v limit="$limit" '
		$7 ~ /^net-autologin(\[[0-9]+\])?:$/ {
			split($6, priority, /\./)
			level = priority[2]
			if (level ~ /^(emerg|alert|crit|err)$/)
				level = "err"
			else if (level == "notice")
				level = "info"

			if (filter == "all" || filter == level) {
				lines[count % limit] = substr($0, 1, 256)
				count++
			}
		}
		END {
			first = count > limit ? count - limit : 0
			for (i = first; i < count; i++)
				print lines[i % limit]
		}
	'
