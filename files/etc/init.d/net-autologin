#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1

start_service() {
	local enabled

	chmod 600 /etc/config/net-autologin || return 1
	config_load net-autologin
	config_get_bool enabled main enabled 0
	if [ "$enabled" -ne 1 ]; then
		rm -f /var/run/net-autologin.status
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/net-autologin
	procd_set_param file /etc/config/net-autologin
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'net-autologin'
}

service_stopped() {
	rm -f /var/run/net-autologin.status
}
